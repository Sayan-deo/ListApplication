        },
        "url": {
          "raw": "{{base_url}}/todos/invalid_id_12345",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "todos",
            "invalid_id_12345"
          ]
        }
      }
    },
    {
      "name": "8. PUT - Partial Update (Only Title)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Test 1: Check status code is 200",
              "pm.test('Status code is 200 for partial update', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Test 2: Check only title is updated",
              "pm.test('Only title is updated', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.title).to.equal('Partial Update Test');",
              "});",
              "",
              "// Test 3: Check other fields can be updated",
              "pm.test('Response contains all fields', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.all.keys('_id', 'title', 'completed', 'dueDate', 'createdAt', '__v');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Partial Update Test\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/todos/{{todo_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "todos",
            "{{todo_id}}"
          ]
        }
      }
    },
    {
      "name": "9. DELETE - Delete Todo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Test 1: Check status code is 200",
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Test 2: Check success message",
              "pm.test('Success message is present', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('message');",
              "    pm.expect(jsonData.message).to.include('deleted');",
              "});",
              "",
              "// Test 3: Clear todo_id from environment after deletion",
              "pm.test('Clear environment after successful deletion', function () {",
              "    pm.environment.unset('todo_id');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/todos/{{todo_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "todos",
            "{{todo_id}}"
          ]
        }
